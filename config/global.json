{
  "device": "cuda:1", //cpu may be very slow, use cuda if you have a compatible GPU, device can be set to "cuda:0" or "cuda:1" etc. if you have multiple GPUs
  "upscaler" : "AnimeSR", //Current support: none, AnimeSR
  "interpolator" : "none", //Current support: none, RIFE
  "frame_window_size" : 12,
  "chunk_num" : 4,  //Parallel processing chunk number, set to 1 if you have low VRAM
  "output_resize" : "lanczos", //Resize method for output, current support: none, lanczos, bilinear, bicubic, spline
  "output_short_edge" : 1080, //Resize short edge to this size
  "output_fps" : 60,  //truncate to this fps after interpolation, set to 0 to disable
  "ffmpeg_encoder" : "hevc_nvenc",  //libx264, libx265, hevc_nvenc, h264_nvenc, vp9_nvenc, ...
  "ffmpeg_preset" : "slow", //slow, medium, fast, p1, p2, p3, p4, p5, p6, p7
  "ffmpeg_crf" : 20,  //Recommended range: 18-28, lower is better quality and larger file size
  "ffmpeg_pixfmt" : "yuv420p",  //yuv420p, yuv422p, yuv444p, yuv420p10le, yuv422p10le, yuv444p10le
  "ffmpeg_extra": "-rc vbr -rc-lookahead 32",  //Custom ffmpeg parameters, you can add more parameters here, for example: "-rc vbr -b:v 5M"
  "temp_dir" : "/dev/shm/janimefix_temp"
}

//After configing this file, you may need to config json files of upscaler and interpolator